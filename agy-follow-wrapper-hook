#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""给 agy-swap 的包装器 ~/.gemini/bin/agy 打一个幂等钩子，让每次调用 agy 前
先跑一次 agy-account-follow --apply --mode pool --jit（Just-In-Time 非阻塞对齐 CLI 凭据）。

用法:
  agy-follow-wrapper-hook --status    # 看是否已打钩且为最新版
  agy-follow-wrapper-hook --install   # 打钩或就地升级旧钩子（自动先备份）
  agy-follow-wrapper-hook --revert    # 撤掉钩子
"""

import argparse
import os
import shutil
import sys
import time

WRAPPER = os.path.expanduser("~/.gemini/bin/agy")
MARK_BEGIN = "# >>> agy-account-follow hook (managed)"
MARK_END = "# <<< agy-account-follow hook"

HOOK_BLOCK = """{begin}
agy_follow_sync() {{
  if [ "${{AGY_FOLLOW_SKIP:-0}}" = "1" ]; then return 0; fi
  _follow="$HOME/.local/bin/agy-account-follow"
  if [ -x "$_follow" ]; then
    "$_follow" --apply --mode "${{AGY_FOLLOW_MODE:-pool}}" --jit >/dev/null 2>&1 || true
  fi
}}
{end}
""".format(begin=MARK_BEGIN, end=MARK_END)

CALL_LINE = "agy_follow_sync"


def read(path):
    with open(path, "r", encoding="utf-8") as fh:
        return fh.read()


def write(path, text):
    tmp = "%s.tmp-agyfollow-%d" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.chmod(tmp, 0o755)
    os.replace(tmp, path)


def has_hook(text):
    return MARK_BEGIN in text and MARK_END in text and CALL_LINE in text


def extract_block(text):
    lines = text.splitlines()
    start, end = None, None
    for i, line in enumerate(lines):
        if line.strip() == MARK_BEGIN and start is None:
            start = i
        elif line.strip() == MARK_END and start is not None:
            end = i
            break
    if start is None or end is None:
        return None
    return "\n".join(lines[start : end + 1])


def is_hook_current(text):
    blk = extract_block(text)
    return blk is not None and blk.strip() == HOOK_BLOCK.strip()


def _replace_block(text):
    lines = text.splitlines()
    out = []
    skipping = False
    replaced = False
    for line in lines:
        if line.strip() == MARK_BEGIN and not replaced:
            skipping = True
            out.extend(HOOK_BLOCK.rstrip("\n").splitlines())
            replaced = True
            continue
        if skipping:
            if line.strip() == MARK_END:
                skipping = False
            continue
        out.append(line)
    return "\n".join(out) + ("\n" if text.endswith("\n") else "")


def install(quiet=False):
    text = read(WRAPPER)
    if has_hook(text):
        if is_hook_current(text):
            if not quiet:
                print("已是最新打钩状态，无需修改")
            return 0
        new_text = _replace_block(text)
        backup = "%s.bak-agyfollow-%s" % (WRAPPER, time.strftime("%Y%m%d-%H%M%S"))
        shutil.copy2(WRAPPER, backup)
        write(WRAPPER, new_text)
        print("已升级旧钩子为 pool --jit 版。备份: %s" % backup)
        return 0

    lines = text.splitlines()
    insert_at = None
    for i, line in enumerate(lines):
        if line.strip() == "esac":
            insert_at = i + 1
            break
    if insert_at is None:
        print("ERROR 找不到 case...esac 快通道，未改动", file=sys.stderr)
        return 4
    lines = lines[:insert_at] + [""] + HOOK_BLOCK.rstrip("\n").splitlines() + lines[insert_at:]

    out = []
    for line in lines:
        out.append(line)
        if "--sync-session" in line and "swap_command" in line:
            indent = line[: len(line) - len(line.lstrip())]
            out.append("%sagy_follow_sync || true" % indent)
    new_text = "\n".join(out) + ("\n" if text.endswith("\n") else "")

    backup = "%s.bak-agyfollow-%s" % (WRAPPER, time.strftime("%Y%m%d-%H%M%S"))
    shutil.copy2(WRAPPER, backup)
    write(WRAPPER, new_text)
    print("已打钩。备份: %s" % backup)
    return 0


def revert():
    text = read(WRAPPER)
    if not has_hook(text):
        print("没有钩子，无需撤销")
        return 0
    lines = text.splitlines()
    out, skipping = [], False
    for line in lines:
        if line.strip() == MARK_BEGIN:
            skipping = True
            continue
        if line.strip() == MARK_END:
            skipping = False
            continue
        if skipping:
            continue
        if line.strip() == "agy_follow_sync || true":
            continue
        out.append(line)
    backup = "%s.bak-agyfollow-%s" % (WRAPPER, time.strftime("%Y%m%d-%H%M%S"))
    shutil.copy2(WRAPPER, backup)
    write(WRAPPER, "\n".join(out) + "\n")
    print("已撤销钩子。备份: %s" % backup)
    return 0


def main():
    ap = argparse.ArgumentParser()
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--status", action="store_true")
    g.add_argument("--install", action="store_true")
    ap.add_argument("--quiet", action="store_true", help="静默模式（launchd 守护用，仅在有动作时说话）")
    g.add_argument("--revert", action="store_true")
    args = ap.parse_args()

    if not os.path.exists(WRAPPER):
        print("ERROR 包装器不存在: %s" % WRAPPER, file=sys.stderr)
        return 4
    text = read(WRAPPER)
    if args.status:
        hooked = has_hook(text)
        current = is_hook_current(text)
        print("包装器      : %s" % WRAPPER)
        print("钩子状态    : %s" % ("已打钩 (最新) ✅" if (hooked and current) else ("已打钩 (旧版需升级) ⚠️" if hooked else "未打钩 ❌")))
        print("agy-swap 标记: %s" % ("有（归 agy-swap 管理）" if "Managed by agy-swap" in text else "无"))
        return 0 if (hooked and current) else 2
    if args.install:
        return install(quiet=args.quiet)
    return revert()


if __name__ == "__main__":
    sys.exit(main())
